<?xml version="1.0"?>
<package format="3">
  <name>resple</name>
  <version>0.0.0</version>

  <description>RESPLE</description>
  <license>GPLv3</license>
  <author>Ziyu Cao</author>
  <author>William Talbot</author>
  <author>Kailai Li</author>
  <maintainer email="ziyu.cao@liu.se">Ziyu Cao</maintainer>
  <maintainer email="kailai.li@rug.nl">Kailai Li</maintainer>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <build_depend>builtin_interfaces</build_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>yaml-cpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_srvs</depend>
  <depend>pcl_conversions</depend>
  <!-- message_runtime is not required for ROS2 packages; removed to match modern ros2 package conventions -->
  <depend>livox_ros_driver</depend>  
  <depend>livox_ros_driver2</depend>
  <depend>livox_interfaces</depend>
  <depend>estimate_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_sensor_msgs</depend>
  <!-- Phase 4: Advanced ROS 2 features -->
  <depend>diagnostic_updater</depend>
  <!-- diagnostic_updater's headers pull in diagnostic_msgs; declare it directly
       ("include what you use") — ament_cmake 2.8's modern-target linking no
       longer propagates a transitive dep's include dirs the way the removed
       ament_target_dependencies did. -->
  <depend>diagnostic_msgs</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- Visualization: foxglove_bridge serves data to Trillium/Foxglove clients;
       rviz2 kept as an optional fallback via resple_viz.launch.py -->
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>eigen</test_depend>
  <exec_depend>builtin_interfaces</exec_depend>  
  <export>
    <build_type>ament_cmake</build_type>
  </export>  
</package>
